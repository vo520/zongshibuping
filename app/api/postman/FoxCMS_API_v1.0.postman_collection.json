            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/column/tree?lang={{lang}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "column", "tree"],
              "query": [
                {
                  "key": "lang",
                  "value": "{{lang}}",
                  "description": "语言标识"
                }
              ]
            },
            "description": "获取栏目树形结构，用于前端导航"
          },
          "response": []
        },
        {
          "name": "获取面包屑导航",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/column/breadcrumb?id=5",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "column", "breadcrumb"],
              "query": [
                {
                  "key": "id",
                  "value": "5",
