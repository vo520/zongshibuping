{
  "info": {
    "name": "FoxCMS API v1.0",
    "description": "FoxCMS API 接口集合，包含栏目、文章、产品、图片、视频、下载、统计等完整接口",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "foxcms-api-v1",
    "_exporter_id": "foxcms-team"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://www.foxcms.text",
      "type": "string"
    },
    {
      "key": "apiPath",
      "value": "/api",
      "type": "string"
    },
    {
      "key": "lang",
      "value": "zh",
      "type": "string"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-App-Id",
        "in": "header"
      },
      {
        "key": "value",
        "value": "app_001",
        "in": "header"
      }
    ]
  },
  "item": [
    {
      "name": "栏目 API",
      "item": [
        {
          "name": "获取栏目列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/column/list?lang={{lang}}&pid=0",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "column", "list"],
              "query": [
                {
                  "key": "lang",
                  "value": "{{lang}}",
                  "description": "语言标识"
                },
                {
                  "key": "pid",
                  "value": "0",
                  "description": "父级栏目ID，-1表示全部，0表示顶级"
                }
              ]
            },
            "description": "获取栏目列表，支持语言和父级栏目筛选"
          },
          "response": []
        },
        {
          "name": "获取栏目详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/column/detail?id=1",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "column", "detail"],
              "query": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "栏目ID"
                }
              ]
            },
            "description": "获取栏目详细信息"
          },
          "response": []
        },
        {
          "name": "获取栏目树形结构",
